---
import Layout from '../layouts/Layout.astro';
import MetricsPanel from '../components/metrics/MetricsPanel';
---

<Layout title="Metrics — superstruct-user">
  <main class="mx-auto w-full max-w-3xl px-4 py-12">
    <header class="mb-8 flex items-baseline justify-between">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Metrics</h1>
        <p class="text-muted-foreground">Users and API health from CloudWatch</p>
      </div>
      <a href="/" class="text-sm text-muted-foreground underline-offset-4 hover:underline">← Home</a>
    </header>
    <MetricsPanel client:only="react" />
  </main>
</Layout>
